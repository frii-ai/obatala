<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>obatala reconcile</title>
<style>__OBATALA_CSS__</style>
</head>
<body>
<header>
  <h1>obatala reconcile</h1>
  <p class="meta">
    source: <code>{{.Source}}</code> · environment: {{.Environment}} · model: {{.Model}} · run started: {{.StartedAt}} ·
    {{len .Results}} failed scenario(s), {{totalSuggestions .Results}} suggestion(s)
  </p>
</header>
<main>
  {{range .Results}}
  <section class="scenario">
    <h2>
      <span class="badge fail">FAIL</span>
      <code>{{.ScenarioID}}</code>
      {{if .Name}}<span class="name">{{.Name}}</span>{{end}}
      <span class="fixture">fixture: {{.Fixture}}</span>
    </h2>

    {{if .UnmetCriteria}}
    <div class="block">
      <h3>Unmet criteria</h3>
      <ul>{{range .UnmetCriteria}}<li>{{.}}</li>{{end}}</ul>
    </div>
    {{end}}

    <div class="block">
      <h3>Diagnosis</h3>
      <p>{{.Diagnosis}}</p>
    </div>

    {{if .Reasoning}}
    <details class="block">
      <summary>Judge reasoning</summary>
      <p class="reasoning">{{.Reasoning}}</p>
    </details>
    {{end}}

    {{if .Suggestions}}
    <div class="block">
      <h3>Suggested prompt edits</h3>
      {{range $i, $s := .Suggestions}}
      <article class="suggestion">
        <h4>
          <span class="badge confidence-{{$s.Confidence}}">{{$s.Confidence}}</span>
          {{$i}}. {{$s.Title}}
          <span class="section">section: {{orDash $s.Section}}</span>
        </h4>
        {{if $s.CurrentExcerpt}}
        <div class="excerpt current">
          <span class="label">current</span>
          <pre>{{$s.CurrentExcerpt}}</pre>
        </div>
        {{end}}
        <div class="excerpt proposed">
          <span class="label">proposed</span>
          <pre>{{$s.ProposedText}}</pre>
        </div>
        {{if $s.TargetsCriteria}}
        <p class="targets">targets: {{range $j, $c := $s.TargetsCriteria}}{{if $j}} · {{end}}<span class="criterion">{{$c}}</span>{{end}}</p>
        {{end}}
      </article>
      {{end}}
    </div>
    {{else}}
    <div class="block">
      <p class="none">No prompt-change suggestions — see diagnosis.</p>
    </div>
    {{end}}
  </section>
  {{end}}
</main>
<footer>
  Generated by obatala. Apply edits to your system prompt, then re-run failed scenarios with
  <code>obatala run -id &lt;scenario&gt;</code>.
</footer>
</body>
</html>
